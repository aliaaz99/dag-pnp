{
  "num_iters": 1000,
  "num_seeds": 10,
  "lambda_data": 1.0,
  "lambda_dag": 0.01,
  "eta": 0.1,
  "c": 0.3,
  "epsilon": 1e-06,
  "s": 4.0,
  "delta_min": 1e-06,
  "k_edges": 4,
  "weight_low": 0.2,
  "weight_high": 0.5,
  "noise_std": 1.0,
  "threshold": "mean off-diagonal absolute estimate, applied to estimate AND ground truth",
