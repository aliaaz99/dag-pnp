  "normalise": false,
  "checkpoint": "ER",
  "denoise_every": 5,
  "initialization": "NumPy default_rng(i).uniform(-.1,.1); zero diagonal",
  "l1": {
    "NOTEARS": 0.01,
    "DAGMA": 0.005,
